                    "text": "def seal_for(public_key, plaintext: bytes) -> dict:\n    shared, encapsulated = public_key.encapsulate()  # GT:H5-N1/op\n    key = HKDF(algorithm=hashes.SHA256(), length=32, salt=None, info=b\"compat\").derive(shared)  # GT:H5-N2"
