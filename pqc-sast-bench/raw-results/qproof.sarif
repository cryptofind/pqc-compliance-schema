            {
              "id": "qproof/AES-128",
              "name": "QuantumVulnerableCrypto",
              "shortDescription": {
                "text": "AES-128 \u2014 Grover's algorithm reduces effective key length to 64-bit, below modern security thresholds"
              },
              "fullDescription": {
                "text": "AES-128 (symmetric) is classified as PARTIAL. Recommended replacement: Upgrade to AES-256-GCM"
              },
              "helpUri": "https://github.com/qproof/qproof#standards-referenced",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "security",
                  "cryptography",
                  "quantum",
                  "pqc"
                ],
                "precision": "medium"
              }
            },
            {
              "id": "qproof/SHA-384",
              "name": "QuantumVulnerableCrypto",
              "shortDescription": {
                "text": "SHA-384 \u2014 Grover reduces preimage resistance to 192-bit \u2014 well above security threshold"
              },
              "fullDescription": {
                "text": "SHA-384 (hash) is classified as SAFE. Recommended replacement: No change needed \u2014 SHA-384 is quantum-safe"
              },
              "helpUri": "https://github.com/qproof/qproof#standards-referenced",
              "defaultConfiguration": {
                "level": "note"
              },
