{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/main/sarif-2.1/schema/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "qproof",
          "version": "0.4.0",
          "informationUri": "https://github.com/qproof/qproof",
          "rules": [
            {
              "id": "qproof/RSA",
              "name": "QuantumVulnerableCrypto",
              "shortDescription": {
                "text": "RSA \u2014 Shor's algorithm factors large integers in polynomial time on a cryptographically relevant quantum computer"
              },
              "fullDescription": {
                "text": "RSA (asymmetric) is classified as VULNERABLE. Recommended replacement: ML-KEM-768/1024 (FIPS 203) for key encapsulation; ML-DSA-65/87 (FIPS 204) for digital signatures"
              },
              "helpUri": "https://github.com/qproof/qproof#standards-referenced",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "cryptography",
                  "quantum",
                  "pqc"
                ],
                "precision": "medium"
              }
            },
            {
              "id": "qproof/SHA-256",
              "name": "QuantumVulnerableCrypto",
              "shortDescription": {
                "text": "SHA-256 \u2014 Grover reduces preimage resistance to 128-bit \u2014 still above security threshold"
              },
              "fullDescription": {
                "text": "SHA-256 (hash) is classified as SAFE. Recommended replacement: No change needed \u2014 SHA-256 is quantum-safe"
              },
              "helpUri": "https://github.com/qproof/qproof#standards-referenced",
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "security",
                  "cryptography",
                  "quantum",
                  "pqc"
                ],
                "precision": "medium"
              }
            },
            {
              "id": "qproof/ECDSA",
              "name": "QuantumVulnerableCrypto",
              "shortDescription": {
                "text": "ECDSA \u2014 Shor's algorithm solves the elliptic curve discrete logarithm problem"
              },
              "fullDescription": {
                "text": "ECDSA (asymmetric) is classified as VULNERABLE. Recommended replacement: ML-DSA-65/87 (FIPS 204) or SLH-DSA (FIPS 205)"
              },
              "helpUri": "https://github.com/qproof/qproof#standards-referenced",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "cryptography",
                  "quantum",
                  "pqc"
                ],
                "precision": "medium"
              }
            },
            {
              "id": "qproof/X25519",
              "name": "QuantumVulnerableCrypto",
              "shortDescription": {
                "text": "X25519 \u2014 Based on elliptic curves \u2014 Shor's algorithm breaks the underlying ECDLP"
              },
              "fullDescription": {
                "text": "X25519 (asymmetric) is classified as VULNERABLE. Recommended replacement: ML-KEM-768 (FIPS 203)"
              },
              "helpUri": "https://github.com/qproof/qproof#standards-referenced",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "cryptography",
                  "quantum",
                  "pqc"
                ],
                "precision": "medium"
              }
            },
            {
              "id": "qproof/Ed25519",
              "name": "QuantumVulnerableCrypto",
              "shortDescription": {
                "text": "Ed25519 \u2014 Based on elliptic curves \u2014 Shor's algorithm breaks the underlying discrete log problem"
              },
              "fullDescription": {
                "text": "Ed25519 (asymmetric) is classified as VULNERABLE. Recommended replacement: ML-DSA-65 (FIPS 204) or SLH-DSA-SHA2-128s (FIPS 205)"
              },
              "helpUri": "https://github.com/qproof/qproof#standards-referenced",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
