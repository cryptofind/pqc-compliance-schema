              "name": "QuantumVulnerableCrypto",
              "shortDescription": {
                "text": "SHA-512 \u2014 Grover reduces preimage resistance to 256-bit \u2014 excellent quantum margin"
              },
              "fullDescription": {
                "text": "SHA-512 (hash) is classified as SAFE. Recommended replacement: No change needed \u2014 SHA-512 is quantum-safe"
              },
              "helpUri": "https://github.com/qproof/qproof#standards-referenced",
              "defaultConfiguration": {
