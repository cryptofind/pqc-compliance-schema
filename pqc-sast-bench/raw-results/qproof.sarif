              },
              "fullDescription": {
                "text": "ECDH (asymmetric) is classified as VULNERABLE. Recommended replacement: ML-KEM-768/1024 (FIPS 203)"
              },
              "helpUri": "https://github.com/qproof/qproof#standards-referenced",
