            },
            {
              "id": "qproof/DH",
              "name": "QuantumVulnerableCrypto",
              "shortDescription": {
                "text": "Diffie-Hellman \u2014 Shor's algorithm solves the discrete logarithm problem in polynomial time"
              },
              "fullDescription": {
                "text": "Diffie-Hellman (asymmetric) is classified as VULNERABLE. Recommended replacement: ML-KEM-768/1024 (FIPS 203)"
              },
              "helpUri": "https://github.com/qproof/qproof#standards-referenced",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
