              }
            },
            {
              "id": "qproof/JWT-RS256",
              "name": "QuantumVulnerableCrypto",
              "shortDescription": {
                "text": "JWT RS256 \u2014 Uses RSA signatures \u2014 broken by Shor's algorithm"
              },
              "fullDescription": {
                "text": "JWT RS256 (protocol) is classified as VULNERABLE. Recommended replacement: JWT with ML-DSA signatures or HMAC-SHA256 (HS256) for symmetric use cases"
              },
              "helpUri": "https://github.com/qproof/qproof#standards-referenced",
              "defaultConfiguration": {
                "level": "error"
              },
