            {
              "id": "qproof/SHA-1",
              "name": "QuantumVulnerableCrypto",
              "shortDescription": {
                "text": "SHA-1 \u2014 Collision attacks are practical classically (SHAttered, 2017) \u2014 do not use for security"
              },
              "fullDescription": {
                "text": "SHA-1 (hash) is classified as VULNERABLE. Recommended replacement: SHA-256 or SHA-3-256 (FIPS 180-4 / FIPS 202)"
              },
              "helpUri": "https://github.com/qproof/qproof#standards-referenced",
              "defaultConfiguration": {
                "level": "error"
