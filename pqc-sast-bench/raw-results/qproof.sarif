            {
              "id": "qproof/TLS-1.3",
              "name": "QuantumVulnerableCrypto",
              "shortDescription": {
                "text": "TLS 1.3 \u2014 Modern protocol but key exchange (X25519/ECDHE) is vulnerable to Shor's algorithm"
              },
              "fullDescription": {
                "text": "TLS 1.3 (protocol) is classified as PARTIAL. Recommended replacement: TLS 1.3 with hybrid post-quantum key exchange (ML-KEM-768 + X25519)"
              },
              "helpUri": "https://github.com/qproof/qproof#standards-referenced",
